[Unit]
Description=Run the foredogs generation every morning at 04:30
Documentation=https://github.com/nichtlegacy/foredogs

[Timer]
# 04:30 rather than just before the display wakes at 05:45: generation usually
# takes 3-7 minutes but has been measured at 19.7. A 15-minute gap once meant
# the panel had already fetched and gone back to sleep before the new picture
# existed, so it showed the previous day's image all day.
OnCalendar=*-*-* 04:30:00

# If the machine was off or asleep at 04:30, run at the next opportunity. This
# mirrors launchd's behaviour, so a laptop that is only open in the evening
# still produces one image a day.
Persistent=true

AccuracySec=1min

[Install]
WantedBy=timers.target
