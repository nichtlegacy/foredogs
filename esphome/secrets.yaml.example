# ESPHome secrets for the foredogs e-paper display.
#
# Copy this file to secrets.yaml in your ESPHome configuration directory
# (usually /config/esphome/secrets.yaml on Home Assistant OS) and fill in your
# own values. secrets.yaml itself must never be committed.
#
# Generate a fresh API encryption key with:
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"

wifi_ssid: "Your WiFi network"
wifi_password: "your-wifi-password"

# Base64, 32 bytes. Home Assistant needs this to talk to the device.
api_encryption_key: "REPLACE_WITH_A_FRESHLY_GENERATED_KEY"

# Protects over-the-air firmware updates.
ota_password: "choose-a-long-random-password"

# Used by the fallback access point the device opens when WiFi is unreachable.
fallback_ap_password: "choose-another-long-random-password"

# Where the device downloads the finished dashboard PNG from.
#
# Prefer an IP address. The ESP32's HTTP client does not resolve other hosts
# over mDNS, so "homeassistant.local" can fail on the device even though it
# works from your laptop.
dashboard_url: "http://10.0.0.2:8123/local/daily_foredogs/dashboard.png"
